\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pyml}[2026/10/30 pyml PDF style]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{titlesec}

\providecommand{\pymltagline}{}

% --- Palette --- %
\definecolor{pymlInk}{HTML}{1E1E2E}         % logo
\definecolor{pymlPrimary}{HTML}{0A7D91}     % --pst-color-primary
\definecolor{pymlPrimaryDark}{HTML}{085D6C} % --pst-color-link-higher-contrast
\definecolor{pymlPrimaryBg}{HTML}{E6F3F6}   % --pst-color-primary-bg ning yengilroq varianti
\definecolor{pymlBorder}{HTML}{D1D5DA}      % --pst-color-border
\definecolor{pymlMuted}{HTML}{48566B}       % --pst-color-text-muted
\definecolor{pymlCodeBg}{HTML}{F6F8FA}
\definecolor{pymlInfo}{HTML}{276BE9}    % --pst-color-info (note bar and title)
\definecolor{pymlInfoBg}{HTML}{DCE7FC}  % --pst-color-info-bg (note title background)

% --- Fonts --- %
\setmainfont{texgyrepagella}[
  Extension      = .otf,
  UprightFont    = *-regular,
  ItalicFont     = *-italic,
  BoldFont       = *-bold,
  BoldItalicFont = *-bolditalic,
]
\setsansfont{texgyreheros}[
  Extension      = .otf,
  UprightFont    = *-regular,
  ItalicFont     = *-italic,
  BoldFont       = *-bold,
  BoldItalicFont = *-bolditalic,
  Scale          = MatchLowercase,
]
\setmonofont{lmmono10-regular}[
  Extension      = .otf,
  UprightFont    = *,
  ItalicFont     = lmmono10-italic,
  BoldFont       = lmmonolt10-bold,
  BoldItalicFont = lmmonolt10-boldoblique,
  Scale          = MatchLowercase,
]

% --- Colors of Sphinx elements --- %
\sphinxsetup{
  TitleColor=pymlPrimaryDark,
  InnerLinkColor=pymlPrimaryDark,
  OuterLinkColor=pymlPrimaryDark,
  VerbatimColor=pymlCodeBg,
  VerbatimBorderColor=pymlBorder,
  % Note box as in the HTML: a blue bar on the left, a light blue title, a white body.
  div.note_border-width=0pt,
  div.note_border-left-width=3pt,
  div.note_border-TeXcolor=pymlInfo,
  div.note_background-TeXcolor=white,
  div.note_border-radius=4pt,
  div.note_title-background-TeXcolor=pymlInfoBg,
  div.note_title-foreground-TeXcolor=pymlInfo,
  % A long code line wraps. Sphinx marks that with a red arrow and a red visible space;
  % both are removed: the space is a plain space and the arrow is empty.
  verbatimvisiblespace={\space},
  verbatimcontinued={},
}

% --- Page --- %
\setlength{\headheight}{14pt}
\setlength{\emergencystretch}{3em}

% --- Chapter headings --- %
\titleformat{\chapter}[hang]
  {\sffamily\bfseries\Huge\color{pymlPrimaryDark}}
  {\color{pymlPrimary}\thechapter}
  {0.6em}
  {}
  [\vspace{0.5em}{\color{pymlBorder}\titlerule[1pt]}]
\titleformat{name=\chapter,numberless}[display]
  {\sffamily\bfseries}
  {}
  {0pt}
  {\Huge\color{pymlPrimaryDark}}
  [\vspace{0.5em}{\color{pymlBorder}\titlerule[1pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{2em}

% --- Tables --- %
% Everything is set at the begin of the document: booktabs sets its own rule widths when it
% is loaded, and the Sphinx table macros must exist before they are extended.
\makeatletter
\AtBeginDocument{%
  \setlength{\heavyrulewidth}{0.6pt}  % top and bottom rule
  \setlength{\lightrulewidth}{0.4pt}  % rule under a table header
  \setlength{\tabcolsep}{9pt}         % space left and right of the text
  \setlength{\extrarowheight}{3pt}    % space above the text in a row
  \arrayrulecolor{pymlBorder}         % soft grey rules, as in the HTML tables
  \newcolumntype{T}{L}                % Sphinx's default column is justified; make it ragged
  % No hyphenation inside tables: a short description should not break "para-meters". The
  % penalties stay local to the table, because Sphinx opens these macros inside a group.
  \g@addto@macro\sphinxattablestart{\hyphenpenalty=10000 \exhyphenpenalty=10000 }%
  \g@addto@macro\sphinxatlongtablestart{\hyphenpenalty=10000 \exhyphenpenalty=10000 }%
}
\makeatother

% --- Title page --- %
\makeatletter
\renewcommand{\sphinxmaketitle}{%
  \let\sphinxrestorepageanchorsetting\relax
  \ifHy@pageanchor\def\sphinxrestorepageanchorsetting{\Hy@pageanchortrue}\fi
  \hypersetup{pageanchor=false}% avoid duplicate destination warnings
  \begin{titlepage}%
    \let\footnotesize\small
    \let\footnoterule\relax
    \begingroup % for PDF information dictionary
     \def\endgraf{ }\def\and{\& }%
     \pdfstringdefDisableCommands{\def\\{, }}% overwrite hyperref setup
     \hypersetup{pdfauthor={\@author}, pdftitle={\@title}}%
    \endgroup
    \raggedright
    \vspace*{0.14\textheight}
    {\color{pymlPrimary}\rule{3.5cm}{4pt}\par}
    \vspace{1.6em}
    {\color{pymlInk}\fontsize{64}{70}\selectfont\ttfamily\bfseries
     $\boldsymbol{\nabla}$\,pyml\par}
    \vspace{0.6em}
    {\sffamily\color{pymlMuted}\fontsize{22}{26}\selectfont Documentation\par}
    \ifx\pymltagline\@empty\else
      \vspace{2.4em}
      \parbox{0.78\textwidth}{\raggedright\color{pymlInk}\large\linespread{1.15}\selectfont
        \pymltagline\par}%
    \fi
    \vfill
    {\sffamily\bfseries\color{pymlPrimaryDark}\Large
     \py@release\releaseinfo\par}
    \vspace{0.8em}
    {\sffamily\color{pymlInk}\large\@author\par}
    \vspace{0.3em}
    {\sffamily\color{pymlMuted}\normalsize\@date\par}
    \@thanks
  \end{titlepage}%
  \setcounter{footnote}{0}%
  \let\thanks\relax\let\maketitle\relax
  \clearpage
  \ifdefined\sphinxbackoftitlepage\sphinxbackoftitlepage\fi
  \if@openright\cleardoublepage\else\clearpage\fi
  \sphinxrestorepageanchorsetting
}
\makeatother
